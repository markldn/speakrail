# AMD/ROCm build using the host's cached vLLM ROCm image as a PyTorch base.
# Keep its ROCm torch/torchaudio instead of replacing them with CUDA wheels.
ARG BASE_IMAGE=capicua25x/vllm-rocm-rdna4:0.26.1-rdna4-rc7
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential ca-certificates curl git libsndfile1 sox && \
    rm -rf /var/lib/apt/lists/*

ARG BREEZE_REPO=https://github.com/speakrail/breeze-tts.git
ARG BREEZE_COMMIT=be25971d96612319f7b65c94f92e0a653fdae239
WORKDIR /opt/breeze
RUN git clone "$BREEZE_REPO" . && git checkout "$BREEZE_COMMIT"

# The ROCm base carries a compatible PyTorch build; the upstream requirements
# pin CUDA torch 2.9.1, so omit only those two runtime packages and test extras.
RUN grep -v -E '^(torch|torchaudio)(==|<|>|$)|^(pytest|ruff)(==|<|>|$)' requirements.txt > /tmp/requirements.txt && \
    python -m pip install -r /tmp/requirements.txt "torchao==0.13.0" && \
    python -c "import torch, torchaudio, torchao, transformers, qwen_tts, fastapi; import breeze_infer.api; \
print('torch', torch.__version__, 'HIP', torch.version.hip, 'torchao', torchao.__version__)"

COPY patches/0001-eager-depth-cudagraph.patch /tmp/eager-depth-cudagraph.patch
RUN git apply /tmp/eager-depth-cudagraph.patch
COPY patches/0002-depth-codebook-limit.patch /tmp/depth-codebook-limit.patch
RUN git apply /tmp/depth-codebook-limit.patch
COPY voice_depth_server.py /opt/breeze/voice_depth_server.py

COPY start.sh /opt/start.sh
RUN chmod +x /opt/start.sh

ENV MODELS_DIR=/models TTS_HOST=0.0.0.0 TTS_PORT=7860 \
    BREEZE_FAST_CONFIG=/opt/breeze/configs/slim.json BREEZE_INT8=backbone,text_encoder
EXPOSE 7860
HEALTHCHECK --interval=10s --timeout=3s --start-period=600s CMD curl -sf http://127.0.0.1:${TTS_PORT}/health || exit 1
ENTRYPOINT ["/opt/start.sh"]
